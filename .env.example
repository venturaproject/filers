PORT=8000

# Set to `production` to enforce the startup config checks: a weak/default
# SEED_USER_PASSWORD, a known default API key, or SEED_DEMO_USERS=true then
# become fatal instead of a warning. Leave unset for local dev.
APP_ENV=

# Comma-separated "service" keys (sent as `x-api-key`) for internal/CI callers.
# Per-user keys also work; external partners use OAuth2 clients (see below).
# Leave empty to disable service keys entirely.
API_KEYS=change-me-in-production

# Max upload size in MB. Keep in sync with `client_max_body_size` in
# infrastructure/nginx/nginx.conf.
MAX_FILE_SIZE_MB=100

# Spreadsheet safety ceilings (defaults shown).
# MAX_CELLS: reject a sheet whose rows*cols exceeds this before it's materialised.
# MAX_UNCOMPRESSED_MB: reject an xlsx/ods whose zip members sum to more than this
#   uncompressed — a cheap zip-bomb guard read from the central directory.
MAX_CELLS=64000000
MAX_UNCOMPRESSED_MB=1024

# Base directory for POST /api/process/batch. The request's optional `path` is
# resolved *relative* to this dir; absolute paths and `..` traversal are rejected.
BATCH_BASE_DIR=./uploads

# Postgres for users / sessions / API clients / tokens / job history.
# Unset => in-memory (fine for local dev; everything resets on restart).
# Both compose files provide a bundled Postgres and point the API at it, so
# leave this blank to use that. Set it to override with an external instance.
DATABASE_URL=

# Credentials for the *bundled* Postgres (compose.dev.yml / compose.prod.yml).
# Ignored when DATABASE_URL points at an external database.
# CHANGE POSTGRES_PASSWORD for any real deployment.
POSTGRES_USER=filers
POSTGRES_PASSWORD=filers
POSTGRES_DB=filers

# Default URL to POST a batch job's final state to on completion
# (per-request `webhook_url` in the batch body overrides it). If WEBHOOK_SECRET
# is set the payload is signed: `X-Filers-Signature: sha256=<hmac>`.
WEBHOOK_URL=
WEBHOOK_SECRET=

# CORS: `*` for local dev. In production set the explicit public origin(s),
# comma-separated, e.g. https://filers.example.com
CORS_ALLOWED_ORIGINS=*

# Trust X-Forwarded-For / X-Real-IP (true when behind the bundled nginx proxy).
# Set to false if the app is exposed directly to clients.
TRUST_PROXY=true

# Per-IP throttle for /api/v1/auth/* and /api/ext/auth/*  ("<attempts>/<seconds>")
AUTH_RATE_LIMIT=10/60

# Per-IP throttle for every other /api route ("<n>/<seconds>", "off" to disable).
# Redundant behind the bundled nginx, but protects a directly-exposed deployment.
API_RATE_LIMIT=120/60

# Serve the OpenAPI spec (/api/openapi.json) + Scalar docs UI (/api/docs).
# Unset  -> on when APP_ENV is not production, off when it is.
# true/false -> force it either way (explicit true in production is allowed but warned).
ENABLE_API_DOCS=

# ── Admin UI auth ───────────────────────────────────────────────────────────
# Public app name served at GET /api/v1/config.
APP_NAME=Filers
# Add `Secure` to the session cookie + emit HSTS — enable when serving over HTTPS.
SESSION_COOKIE_SECURE=false
# Admin account seeded into the in-memory user store on startup.
SEED_USER_EMAIL=admin@filers.test
SEED_USER_PASSWORD=admin1234
SEED_USER_NAME=Admin
# API key owned by the seeded user (defaults to the first API_KEYS entry).
SEED_USER_API_KEY=dev-key
# Seed the demo `user` accounts (maria@ / carlos@, password "demo1234").
# Dev convenience only — MUST be false in production.
SEED_DEMO_USERS=true

# ── External API clients (OAuth2 client-credentials) ────────────────────────
# Defaults applied to clients that don't set their own. Empty = unlimited.
# Rate limit format: "<requests>/<seconds>", e.g. 60/60
EXT_DEFAULT_RATE_LIMIT=
EXT_DEFAULT_MONTHLY_PAGE_QUOTA=

RUST_LOG=rust_api=info,tower_http=info
