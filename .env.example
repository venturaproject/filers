PORT=8000

# Comma-separated list of valid API keys
API_KEYS=change-me-in-production

# Max upload size in MB
MAX_FILE_SIZE_MB=100

# Default directory scanned by POST /api/process/batch
BATCH_BASE_DIR=./uploads

# CORS (use * for dev, restrict in prod)
CORS_ALLOWED_ORIGINS=*

RUST_LOG=rust_api=info,tower_http=info
